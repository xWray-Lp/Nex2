fn greet(name: str) -> str:
    return "Hello, " + name + "!"

fn factorial(n: int) -> int:
    if n == 0:
        return 1
    else:
        return n * factorial(n - 1)

fn main():
    print(greet("Nex"))

    let result = factorial(10)
    print("10! = " + str(result))

    let total = 0
    for i in 0..10:
        total = total + i
    print("Sum 0..9 = " + str(total))

    let nums = [3, 1, 4, 1, 5, 9, 2, 6]
    let max_val = nums[0]
    for n in nums:
        if n > max_val:
            max_val = n
    print("Max = " + str(max_val))

    let flag = true and not false
    print("Logic: " + str(flag))

main()
